{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "welfare-document-v1/table.schema.json",
  "title": "tables.jsonl 한 줄(정규화 표)",
  "type": "object",
  "required": [
    "table_id",
    "ir_pointer",
    "source_id_available",
    "source_table_id",
    "logical_rows",
    "logical_columns",
    "cells",
    "caption_refs",
    "header_paths",
    "footnote_refs",
    "physical_fragments",
    "classification",
    "quality_flags"
  ],
  "properties": {
    "table_id": {
      "type": "string",
      "pattern": "^t:[0-9a-f]{16}$"
    },
    "ir_pointer": {
      "type": "string",
      "pattern": "^/blocks/"
    },
    "source_id_available": {
      "type": "boolean"
    },
    "source_table_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "logical_rows": {
      "type": "integer",
      "minimum": 0
    },
    "logical_columns": {
      "type": "integer",
      "minimum": 0
    },
    "header_basis": {
      "enum": [
        "cell_header_marks",
        "cell_header_marks_with_span_continuation",
        "layout_hint_unconfirmed",
        "none"
      ]
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cell_id",
          "anchor_row",
          "anchor_col",
          "row_span",
          "col_span",
          "parsed_text_verbatim",
          "normalized_text",
          "content_refs",
          "value_state",
          "source_refs"
        ],
        "properties": {
          "cell_id": {
            "type": "string"
          },
          "anchor_row": {
            "type": "integer",
            "minimum": 0
          },
          "anchor_col": {
            "type": "integer",
            "minimum": 0
          },
          "row_span": {
            "type": "integer",
            "minimum": 1
          },
          "col_span": {
            "type": "integer",
            "minimum": 1
          },
          "parsed_text_verbatim": {
            "type": "string"
          },
          "normalized_text": {
            "type": "string"
          },
          "content_refs": {
            "type": "array"
          },
          "value_state": {
            "enum": [
              "value",
              "empty",
              "zero",
              "not_applicable",
              "unknown",
              "covered_by_merge",
              "unreadable",
              "placeholder"
            ]
          },
          "source_refs": {
            "type": "array",
            "minItems": 1
          },
          "normalized_value": {
            "type": "object",
            "required": [
              "value",
              "unit",
              "status",
              "trace"
            ],
            "properties": {
              "value": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "normalized",
                  "no_explicit_unit",
                  "provisional_footnote_scope",
                  "inequality_bound",
                  "ocr_needs_review"
                ]
              },
              "trace": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      }
    },
    "caption_refs": {
      "type": "array"
    },
    "header_paths": {
      "type": "array"
    },
    "footnote_refs": {
      "type": "array"
    },
    "physical_fragments": {
      "type": "array",
      "minItems": 1
    },
    "classification": {
      "type": [
        "object",
        "null"
      ]
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extraction_method": {
      "enum": [
        "structured_source",
        "text_layer",
        "ocr_page",
        "text_layer_with_ocr_regions",
        "ocr_image"
      ]
    }
  }
}
